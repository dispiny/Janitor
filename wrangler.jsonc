{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API must hit the Worker before SPA fallback serves index.html
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Keep dashboard Variables on deploy (secrets are never wiped either).
  // Without this, a deploy can delete SUPABASE_* you set only in the CF UI.
  "keep_vars": true,
  // Cron: janitor_maintenance() — retention cleanup + "에이전트 응답 없음" Slack alert.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Public project URL only — never commit SUPABASE_ANON_KEY / SERVICE_ROLE here.
  "vars": {
    "SUPABASE_URL": "https://ypklxfwpbyroxdolgiun.supabase.co"
  }
  // Custom domain (e.g. ops.example.com): manage in Dashboard, or set on the
  // deploy host via CLOUDFLARE_CUSTOM_DOMAIN + CLOUDFLARE_ZONE_NAME (not in git).
  // Secrets (not committed — use Secret, not plain Variable):
  //   wrangler secret put SUPABASE_ANON_KEY
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY  # agent poll/report
  //   wrangler secret put SLACK_WEBHOOK_URL   # optional
  // Local: copy .dev.vars.example → .dev.vars
}
