# Required. Cloud Worker / local callers use Authorization: Bearer <token>
AGENT_TOKEN=change-me

# Listen address (LAN / tunnel origin)
PORT=3920
HOST=0.0.0.0

# Worker base URL for job poller (local wrangler dev example — set your real URL in .env only)
JANITOR_API_URL=http://127.0.0.1:8787
AGENT_POLL_MS=15000
AGENT_HOST_LABEL=

# Speed test (Fast.com-like: parallel CDN download + Cloudflare upload)
# SPEEDTEST_PROVIDER=auto|fast|cloudflare
SPEEDTEST_PROVIDER=auto
SPEEDTEST_DURATION_MS=12000
SPEEDTEST_CONNECTIONS=4
# Legacy single-shot byte cap (unused by Fast.com-style runner; kept for compat)
SPEED_PROBE_BYTES=2000000

# Optional. Hostname advertised to the dashboard (CF Tunnel public hostname)
CF_TUNNEL_HOSTNAME=

# Optional. Opt-in remote update from dashboard (git pull + npm + pm2 restart)
AGENT_ALLOW_REMOTE_UPDATE=false
# Also run `npm run deploy` (wrangler) at repo root when updating. Defaults to same as remote update.
# Requires CLOUDFLARE_API_TOKEN on this host (Account → API Tokens → Edit Cloudflare Workers).
AGENT_DEPLOY_ON_UPDATE=true
CLOUDFLARE_API_TOKEN=
PM2_APP_NAME=ops-agent
# AGENT_REPO_DIR=  # agent package dir; git root is discovered for deploy

# Optional. Sent as Authorization when health-check requests set useHealthToken
HEALTHCHECK_TOKEN=
